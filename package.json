{
  "name": "prow-github-actions",
  "version": "2.0.0",
  "description": "Slash commands, jobs, and chat-ops for Github actions inspired by Kubernetes Prow",
  "author": "John McBride",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cncf/prow-github-actions.git"
  },
  "keywords": [
    "actions",
    "prow"
  ],
  "main": "lib/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pack": "ncc build",
    "test": "vitest run",
    "test-all": "npm run build && npm run pack && npm test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "all": "npm run build && npm run lint:fix && npm run lint && npm run pack && npm test"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@octokit/rest": "^20.0.1",
    "@octokit/types": "^11.1.0",
    "@octokit/webhooks": "^12.0.3",
    "minimatch": "^9.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^24",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.32.0",
    "js-yaml": "^4.1.0",
    "msw": "^2.15.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "undici": "^6.28.1"
  }
}
