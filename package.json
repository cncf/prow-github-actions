{
  "name": "prow-github-actions",
  "version": "3.0.1",
  "description": "Slash commands, jobs, and chat-ops for Github actions inspired by Kubernetes Prow",
  "author": "John McBride",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cncf/prow-github-actions.git"
  },
  "keywords": [
    "actions",
    "prow"
  ],
  "main": "lib/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pack": "ncc build",
    "test": "vitest run",
    "test-all": "npm run build && npm run pack && npm test",
    "test:coverage": "vitest run --coverage",
    "pack:coverage": "ncc build __tests__/bundle/coverageEntry/main.ts -o .coverage-bundle --source-map --no-source-map-register",
    "test:coverage:e2e": "npm run pack:coverage && vitest run --coverage --config vitest.e2e-coverage.config.mjs __tests__/bundle",
    "test:watch": "vitest",
    "all": "npm run build && npm run lint:fix && npm run lint && npm run pack && npm test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/rest": "^22.0.1",
    "js-yaml": "^5.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "msw": "^3.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
